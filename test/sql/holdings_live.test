# name: test/sql/holdings_live.test
# description: globalx.holdings live invariants: partition pushdown and pushed filters (hits Global X).
# group: [sql]

require-env VGI_TEST_WORKER

# Live: hits Global X. Opt in with GLOBALX_LIVE=1 (the scheduled/main-only CI job does);
# normal runs skip this file (EXPECTED_SKIP_REASONS) so CI stays deterministic.
require-env GLOBALX_LIVE

statement ok
ATTACH 'globalx' AS gx (TYPE vgi, LOCATION '{VGI_TEST_WORKER}');

statement ok
SET search_path='gx.main';

# --- Live invariants (hit Global X). ---

# Partition pushdown: WHERE fund_ticker = 'QYLD' fetches that fund's holdings, weight-descending.
query I
SELECT (count(*) > 50 AND max(weight_percent) > 0 AND bool_and(fund_ticker = 'QYLD'))::INT
FROM gx.holdings WHERE fund_ticker = 'QYLD';
----
1

# Multiple partitions at once: fund_ticker IN (...) fans out to two funds.
query I
SELECT (count(DISTINCT fund_ticker) = 2)::INT FROM gx.holdings WHERE fund_ticker IN ('QYLD', 'COPX');
----
1

# An unfiltered scan is allowed — it streams EVERY fund's holdings (one partition per fund).
# LIMIT short-circuits the stream after the first partition, so this stays cheap.
query I
SELECT (count(*) >= 1)::INT FROM (SELECT * FROM gx.holdings LIMIT 5);
----
1

# The backing scan function also works directly (pushdown).
query I
SELECT (count(*) > 50)::INT FROM gx.holdings_scan() WHERE fund_ticker = 'QYLD';
----
1

# Every pushed filter is honored, not just the fund_ticker partition key: DuckDB drops a
# pushed predicate from its own plan, so a constituent filter must be applied by the scan
# (regression: `AND ticker = 'AAPL'` used to return the fund's whole portfolio).
query I
SELECT (count(*) = 1 AND bool_and(ticker = 'AAPL'))::INT
FROM gx.holdings WHERE fund_ticker = 'QYLD' AND ticker = 'AAPL';
----
1

query I
SELECT (count(*) > 0 AND bool_and(weight_percent > 3))::INT
FROM gx.holdings WHERE fund_ticker = 'QYLD' AND weight_percent > 3;
----
1

# ...including when no fund_ticker filter narrows the partitions (every fund is scanned).
query I
SELECT (count(*) > 5 AND bool_and(ticker = 'NVDA') AND count(DISTINCT fund_ticker) = count(*))::INT
FROM gx.holdings WHERE ticker = 'NVDA';
----
1
