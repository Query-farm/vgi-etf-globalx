# name: test/sql/holdings.test
# description: globalx.holdings base table — fund_ticker partition (pushdown), current holdings only.
# group: [sql]

require-env VGI_TEST_WORKER

statement ok
ATTACH 'globalx' AS gx (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SET search_path='gx.main';

# --- Schema: DESCRIBE binds only (no network). `holdings` is a base TABLE. ---

query T
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM gx.holdings WHERE fund_ticker = 'QYLD');
----
fund_ticker,as_of_date,weight_percent,ticker,name,sedol,market_price,shares_held,market_value

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM gx.holdings WHERE fund_ticker = 'QYLD') WHERE column_name = 'as_of_date';
----
DATE

# --- Live invariants (hit Global X). ---

# Partition pushdown: WHERE fund_ticker = 'QYLD' fetches that fund's holdings, weight-descending.
query I
SELECT (count(*) > 50 AND max(weight_percent) > 0 AND bool_and(fund_ticker = 'QYLD'))::INT
FROM gx.holdings WHERE fund_ticker = 'QYLD';
----
1

# Multiple partitions at once: fund_ticker IN (...) fans out to two funds.
query I
SELECT (count(DISTINCT fund_ticker) = 2)::INT FROM gx.holdings WHERE fund_ticker IN ('QYLD', 'COPX');
----
1

# An unfiltered scan is allowed — it streams EVERY fund's holdings (one partition per fund).
# LIMIT short-circuits the stream after the first partition, so this stays cheap.
query I
SELECT (count(*) >= 1)::INT FROM (SELECT * FROM gx.holdings LIMIT 5);
----
1

# The backing scan function also works directly (pushdown).
query I
SELECT (count(*) > 50)::INT FROM gx.holdings_scan() WHERE fund_ticker = 'QYLD';
----
1
